# ═══════════════════════════════════════════════════════════════════════════════
# 🦅 EAGLE FLASH & SIGMA TERMINAL — ENVIRONMENT CONFIGURATION TEMPLATE
# NEVER COMMIT REAL PRIVATE KEYS OR CREDENTIALS TO VERSION CONTROL
# ═══════════════════════════════════════════════════════════════════════════════

# 1. PostgreSQL / Supabase Operational Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key
SUPABASE_PROJECT_REF=your_supabase_project_ref

# 2. Telegram Alert Engine
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id_or_channel_id

# 3. Discord Alert & Bot Engine (Rotate compromised tokens; load strictly via backend)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id
DISCORD_GUILD_ID=your_discord_guild_id

# Discord Configurable Channel IDs
DISCORD_CHANNEL_SIGNALS=your_channel_id_signals
DISCORD_CHANNEL_QUICK_PUMP=your_channel_id_quick_pump
DISCORD_CHANNEL_BREAKOUTS=your_channel_id_breakouts
DISCORD_CHANNEL_WHALES=your_channel_id_whales
DISCORD_CHANNEL_SQUEEZES=your_channel_id_squeezes
DISCORD_CHANNEL_BIG_CAP=your_channel_id_big_cap
DISCORD_CHANNEL_TP_HITS=your_channel_id_tp_hits
DISCORD_CHANNEL_STOP_LOSS=your_channel_id_stop_loss
DISCORD_CHANNEL_MARKET_ALERTS=your_channel_id_market_alerts
DISCORD_CHANNEL_BLOCKCHAIN_PROOF=your_channel_id_blockchain_proof
DISCORD_CHANNEL_BOT_STATUS=your_channel_id_bot_status

# 4. Exchange API Credentials (Read-Only / Market-Data)
MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret
WEEX_API_KEY=your_weex_api_key
WEEX_API_SECRET=your_weex_api_secret

# 5. Blockchain RPC & On-Chain Indexers
ETHERSCAN_API_KEY=your_etherscan_api_key
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your_key

# 6. Service Configuration & Port Binding
PORT=3000
NODE_ENV=production
