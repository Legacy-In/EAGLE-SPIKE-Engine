# ═══════════════════════════════════════════════════════════════════════════════
# 🦅 EAGLE FLASH — PRODUCTION CONFIGURATION TEMPLATE
# Copy to .env or apps/web/.env.local and configure your secrets.
# NEVER commit real tokens or credentials into Git.
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Telegram Bot Credentials (@eaglespike_bot)
# Revoke and obtain your token securely from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Secret string used to validate incoming Telegram webhook requests (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here
# Optional comma-separated list of authorized Telegram chat IDs permitted to query admin commands
TELEGRAM_AUTHORIZED_CHATS=

# 2. Multi-Exchange Market Data Credentials
# MEXC Contract API
MEXC_API_KEY=your_mexc_api_key_here
MEXC_API_SECRET=your_mexc_api_secret_here

# WEEX Contract API
WEEX_API_KEY=your_weex_api_key_here
WEEX_API_SECRET=your_weex_api_secret_here

# Bybit Linear API (Optional for public endpoints; required for authenticated endpoints)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# 3. Spike Intelligence Engine Thresholds
SPIKE_MIN_RVOL=2.0
SPIKE_MIN_VOLUME_Z=2.5
SPIKE_MIN_SCORE=70
SPIKE_COOLDOWN_MINUTES=20
DATA_STALE_THRESHOLD_SECONDS=30
